section.price-list#price-list
	.container
		.price-list__categories
			each category in priceCategories
				+collapse({ title: category.title, open: category.open, heading: 'h2' }).price-list__category
					.price-list__body
						if category.consult
							p.price-list__consult
								span.price-list__consult-name= category.consult.name
								span.price-list__consult-price= category.consult.price
						if category.groups
							.price-list__groups
								each group in category.groups
									+collapse({ title: group.title, open: group.open, sub: true, heading: 'h3' }).price-list__group
										ul.price-list__lines
											each item in group.items || priceSample
												+priceLine(Object.assign({ note: priceNote }, item)).price-line--divided
						else
							ul.price-list__lines
								each item in priceSample
									+priceLine(Object.assign({ note: priceNote }, item)).price-line--divided
		.price-list__actions
			+btn('Записаться на прием', { href: '#signup-popup' }).price-list__btn(data-signup-open)
			+btn('Скачать полный прайс-лист', { href: '#' }).btn--secondary.price-list__btn(download)
	.price-list__calc
		include calc
