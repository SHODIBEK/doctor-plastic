-
	const relatedArticles = [
		{ title: 'Подтяжка без имплантов: когда это реально хватает?', text: 'Многие женщины сталкиваются с тем, что после грудного вскармливания или резкого похудения грудь теряет былую высоту, но при этом сохраняет достаточный объем мягких тканей. Возникает эффект пустого конверта или выраженный птоз, когда сосок опускается ниже подгрудной складки.', date: '30.01.2026', datetime: '2026-01-30', image: 'related/article-1', href: './article.html' },
		{ title: 'Блефаропластика нижних век: что это, как делают операцию', text: 'Нижняя блефаропластика представляет собой высокоточное хирургическое вмешательство, сфокусированное на реконструкции области под глазами. Основная цель данной пластической операции — коррекция таких эстетических дефектов, как избыточные жировые выпячивания («грыжи»), провисание кожного лоскута и углубление носослёзной борозды.', date: '30.01.2026', datetime: '2026-01-30', image: 'related/article-2', href: './article.html' },
		{ title: 'Подтяжка без имплантов: когда это реально хватает?', text: 'Многие женщины сталкиваются с тем, что после грудного вскармливания или резкого похудения грудь теряет былую высоту, но при этом сохраняет достаточный объем мягких тканей. Возникает эффект пустого конверта или выраженный птоз, когда сосок опускается ниже подгрудной складки.', date: '30.01.2026', datetime: '2026-01-30', image: 'related/article-1', href: './article.html' },
	]

section.related
	.container.card-slider.card-slider--articles(data-card-slider)
		.card-slider__aside
			h2.title.card-slider__title!= typeof relatedTitle !== 'undefined' ? relatedTitle : 'Смотрите также'
			.card-slider__nav
				+btnRound('prev')(data-card-slider-prev)
				+btnRound('next')(data-card-slider-next)
		.card-slider__viewport.swiper(data-card-slider-swiper)
			ul.card-slider__track.swiper-wrapper
				each item in relatedArticles
					li.card-slider__slide.swiper-slide
						+articleCard(item)
