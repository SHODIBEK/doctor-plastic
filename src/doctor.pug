extends pug/layout

append vars
	- title = 'Сергеев Илья Вячеславович — пластический хирург, основатель клиники | Доктор Пластик'
	- meta.description = meta.ogDescription = meta.twitterDescription = 'Сергеев Илья Вячеславович — основатель клиники «Доктор Пластик», пластический хирург, профессор. Биография, образование, работы до/после, дипломы, цены и рейтинги. Запись на консультацию.'
	- meta.ogTitle = meta.twitterTitle = title
	-
		const pageHead = {
			modifier: 'doctor',
			crumbs: [{ title: 'Главная', href: './home.html' }, { title: 'Специалисты' }],
			accent: 'Сергеев',
			title: 'Илья Вячеславович',
			text: 'Основатель клиники «ДОКТОРПЛАСТИК», пластический хирург, профессор, основатель собственной школы маммопластики,<br> автор множества запатентованных методик',
			video: { title: 'Смотреть видео-визитку', href: 'https://www.youtube.com/watch?v=' },
			woman: { desktop: 'doctor-head/sergeev', desktopWidth: 604, desktopHeight: 895, retina: true, mobile: 'doctor-head/sergeev-mobile', mobileWidth: 249, mobileHeight: 369 },
		}
		const doctorStats = [
			{ icon: 'stethoscope', label: 'Стаж работы', value: '11 лет' },
			{ icon: 'surgical-instrument', label: 'Количество операций', value: '1385' },
			{ icon: 'health-care', label: 'Средний рейтинг', value: '5.0', stars: true },
		]
		const doctorBio = {
			id: 'bio',
			title: 'Биография',
			more: 'Открыть биографию',
			text: [
				'Исмиев Ахмед Эльданизович — перспективный молодой пластический хирург, чьи работы стабильно демонстрируют показательно образцовые результаты как в плане эстетики, так и функциональности.',
				'Провёл более 3&nbsp;000 пластических операций.',
				'Ахмед Эльданизович выполняет широкий перечень пластических операций. В список его полномочий входят блефаропластика, увеличение и уменьшение груди, Т-образная мастопексия, абдоминопластика, липосакция и липофилинг молочных желез.',
				'Несмотря на активный график операций, пластический хирург старается не пропускать важные конгрессы и симпозиумы, чтобы всегда оставаться в курсе последних достижений отрасли. Так, среди последних мероприятий, в которых Ахмед Исмиев успел поучаствовать, значатся II Международный конгресс «Мультидисциплинарная эстетическая медицина» (2021г), Международная научная конференция «Современные тенденции исследований в области пластической хирургии и эстетической медицины» (2022г) и XI Национальный конгресс с международным участием имени Н.О. Миланова «Пластическая хирургия, эстетическая медицина и косметология» (2022г).',
				'В прошлом 2023 году доктор принял участие в V Юбилейной инновационной школе эстетической медицины, Летнем конгрессе «Пластическая, реконструктивная хирургия и косметология» в Санкт-Петербурге. И, конечно, специалист не позволил себе пропустить важный XII Национальный конгресс с международным участием им. Н.О. Миланова «Пластическая хирургия, эстетическая медицина и косметология». «Работа в пластической хирургии — это мечта, к которой я стремился с юных лет. Красота и эстетика всегда были ключевыми факторами в выборе моей профессии. Каждая девушка красива от природы, но желание подарить своим пациентам то, о чём они всегда мечтали — вот мой главный приоритет», — так говорит о значении своей профессии Ахмед Исмиев.',
			],
		}
		const doctorEducation = {
			id: 'education',
			title: 'Образование',
			more: 'Открыть образование',
			text: [
				'Свой путь в эстетическую медицину Ахмед Исмиев начал в Саратове, где успешно окончил СГМУ им. В.И. Разумовского по специальности «Лечебное дело». Во время обучения он всегда стремился использовать любые возможности, чтобы овладеть необходимыми навыками и быть готовым к любому развитию событий в ходе оперативного вмешательства. Будучи студентом, он 4 года дежурил в хирургическом отделении КБ им С.Р. Миротворцева г. Саратова, ассистировал на операциях разного профиля и сложности, включая лапароскопические вмешательства.',
				'Ахмед Эльданизович имеет широкие компетенции и в челюстно-лицевой хирургии. На его счёту 2 года работы ассистентом врача стоматолога-хирурга, ассистирование в костно-пластических операциях, мукогингивальной хирургии. Врач принимал непосредственное участие в имплантации и удалении зубов.',
				'В настоящее время всё своё время Ахмед Исмиев посвящает пластической хирургии. Доктор получил эти знания, навыки и специализацию в Московском областном научно-исследовательском клиническом институте им. М.Ф. Владимирского. Здесь он на профильной кафедре обучался в ординатуре (2021–2023г.), во время которой проходил стажировки в авторитетных медцентрах — «Институте пластической хирургии и косметологии», «Бюстклинике», «Клинике пластической хирургии и косметологии Dr.Shihirman» и клинике «Doctor Plastic».',
			],
		}
		const doctorPrices = {
			groups: [
				{
					items: [
						{ name: 'Увеличение груди – доступ через субмаммарную складку (без стоимости имплантов)', price: '502 400 ₽' },
						{ name: 'Увеличение груди – периареолярный доступ (без стоимости имплантов)', price: '295 400 ₽', oldPrice: '502 400 ₽' },
						{ name: 'Увеличение груди – подмышечный доступ (без стоимости имплантов)', price: '579 500 ₽' },
						{ name: 'Увеличение груди с коррекцией ассиметрии (без стоимости импланта)', price: '590 000 ₽' },
						{ name: 'Увеличение одной груди (без стоимости импланта)', price: '295 400 ₽', oldPrice: '354 000 ₽' },
						{ name: 'Подтяжка груди с увеличением 2 кат. сложности с вертикальным рубцом (без стоимости имплантов)', price: '665 000 ₽' },
					],
				},
			],
		}
		const worksTitle = 'Работы специалиста'
		const diplomasTitle = 'Дипломы<br class="diplomas__break"> специалиста'
		const worksMore = false

block main
	include pug/sections/page-head
	include pug/sections/doctor-text
	.panel.panel--doctor
		include pug/sections/doctor-stats
		+doctorText(doctorBio)
		include pug/sections/works
		+doctorText(doctorEducation)
		include pug/sections/diplomas
		include pug/sections/prices
		include pug/sections/video
		include pug/sections/ratings
		include pug/sections/signup
