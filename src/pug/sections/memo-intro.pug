//- Памятка пациента: вступление и вопросы хирургу, справа фото на бирюзовом круге
-
	const memoQuestions = [
		'сколько будет стоить операция, нужно ли дополнительно оплачивать импланты, приобретать компрессионное бельё;',
		'как она будет проходить и сколько продлится;',
		'определитесь с имплантами — проконсультируйтесь с врачом, подойдут ли вам круглые или анатомические, какого производителя предпочесть и почему;',
		'расспросите хирурга о наиболее оптимальном для вас положении имплантов;',
		'спросите, где будет располагаться разрез;',
		'как вы будете чувствовать себя после операции, к чему быть готовой и как облегчить процесс реабилитации;',
		'возьмите экземпляр договора, чтобы в спокойной обстановке ознакомиться с его условиями;',
		'выберите вместе с вашим врачом подходящую дату операции. Помните, что в первую неделю после неё вы будете чувствовать дискомфорт при выполнении привычных действий, придётся обойтись без активных занятий спортом и перегрева в бане, сауне, солярии и на пляже.',
	]

section.memo-intro
	.container.container--narrow.memo-intro__container
		.memo-intro__content
			p.memo-intro__text!= nbsp('Готовиться к пластической операции вы начинаете задолго до прихода в «Бюстклинику», когда впервые возникает желание изменить размер или форму груди. Конечно, у вас появляется множество вопросов, касающихся безопасности проведения операции, её результата и сохранения эффекта. Не стесняйтесь все их выписать на лист бумаги, чтобы озвучить на консультации в кабинете врача. Неплохо посмотреть на фотографии результатов его работы и отметить, какие из них вам больше всего нравятся и почему. Это поможет определиться с желаемым размером груди и её формой. Если вы до конца не понимаете, чего хотите, посоветуйтесь со специалистом, но помните, что только вы сможете принять окончательное решение. Хирурги «Бюстклиники» готовы развеять все ваши сомнения и ответить на любые вопросы!')
			.memo-intro__questions
				h2.title.title--h3.memo-intro__title Задайте выбранному хирургу главные вопросы о предстоящей операции:
				ul.bullets
					each question in memoQuestions
						li.bullets__item!= nbsp(question)
		.memo-intro__visual
			+picture('memo/woman', 'Пациентка клиники перед консультацией', 537, 1030).memo-intro__image
