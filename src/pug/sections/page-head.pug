//- Заголовок внутренней страницы: крошки + h1 + графика.
//- Данные: pageHead = { crumbs, title, accent, modifier, woman }. Картинки — первый экран, поэтому без lazy
-
	const headWoman = pageHead.woman || { desktop: 'page-head/woman', desktopWidth: 1024, desktopHeight: 1024, mobile: 'page-head/woman-mobile', mobileWidth: 350, mobileHeight: 350 }
	const headWomanSrc = `${baseDir}images/content/${headWoman.desktop}`

section.page-head(class=pageHead.modifier ? `page-head--${pageHead.modifier}` : null)
	.page-head__graphic(aria-hidden="true")
		img.page-head__ellipse(src=`${baseDir}images/content/page-head/ellipse.svg` width="405" height="405" alt="" loading="lazy" decoding="async")
		img.page-head__circle(src=`${baseDir}images/content/page-head/circle.webp` srcset=`${baseDir}images/content/page-head/circle@2x.webp 2x` width="403" height="403" alt="" loading="lazy" decoding="async")
		if pageHead.photo
			//- Одно фото на всех ширинах: браузер выбирает размер по sizes
			img.page-head__photo(src=`${baseDir}images/content/${pageHead.photo.src}.webp` srcset=pageHead.photo.srcset.map((item) => `${baseDir}images/content/${item}`).join(', ') sizes=pageHead.photo.sizes width=pageHead.photo.width height=pageHead.photo.height alt="" fetchpriority="high")
		else
			picture.page-head__woman
				source(media="(min-width: 1024px)" srcset=headWoman.retina ? `${headWomanSrc}.webp 1x, ${headWomanSrc}@2x.webp 2x` : `${headWomanSrc}.webp` width=headWoman.desktopWidth height=headWoman.desktopHeight)
				img.page-head__woman-image(src=`${baseDir}images/content/${headWoman.mobile}.webp` srcset=`${baseDir}images/content/${headWoman.mobile}@2x.webp 2x` width=headWoman.mobileWidth height=headWoman.mobileHeight alt="" fetchpriority="high")
	.container.page-head__container
		+breadcrumbs(pageHead.crumbs).page-head__breadcrumbs(data-overflow-fade)
		if pageHead.text
			//- Шапка врача: ФИО, должность и видео-визитка
			.page-head__body
				h1.page-head__title
					span.page-head__title-accent= pageHead.accent
					= ' '
					span.page-head__title-text= pageHead.title
				p.page-head__text!= pageHead.text
				if pageHead.video
					a.page-head__video(href=pageHead.video.href data-fancybox)
						span.btn-play.page-head__play
							+svg('play').btn-play__icon
						span.btn.page-head__btn
							span= pageHead.video.title
		else
			h1.page-head__title
				span.page-head__title-accent= pageHead.accent
				if pageHead.title
					= ' '
					span.page-head__title-text= pageHead.title
