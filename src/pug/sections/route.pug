//- Как добраться: схема проезда (ссылка на Яндекс Карты) и маршруты.
//- В WP: колонки — повторитель ACF, части — абзацы и списки
-
	const routeMapHref = 'https://yandex.ru/maps/?text=%D0%9C%D0%BE%D1%81%D0%BA%D0%B2%D0%B0%2C%20%D1%83%D0%BB.%20%D0%9C%D1%8F%D1%81%D0%BD%D0%B8%D1%86%D0%BA%D0%B0%D1%8F%2032'
	const routeColumns = [
		{
			title: 'Общественным транспортом',
			parts: [
				{ text: 'Пешком до нашей клиники удобнее добраться от м. Красносельская (примерно 10 минут):' },
				{ list: [
					'Выйдя из метро, перейдите через Краснопрудную улицу на улицу Нижняя Красносельская',
					'Пройдите по мосту через ж.д. пути до поворота направо на улицу Ольховская',
					'Через 200 метров вы увидите здание Института (ул. Нижняя Красносельская, 32/29с3)',
				] },
				{ text: 'или м.Бауманская:' },
				{ list: [
					'Выйдя из метро, перейдите через Бауманскую улицу, и пройдите через ТЦ «Елоховский пассаж» до светофора',
					'Перейдите через Спартаковскую улицу на улицу Нижняя Красносельская',
					'Пройдите по нечётной стороне улицы (Ориентир БЦ «Новь») до поворота налево на улицу Ольховская',
					'Через 200 метров вы увидите здание Института (ул. Нижняя Красносельская, 32/29с3)',
				] },
			],
		},
		{
			title: 'На машине',
			parts: [
				{ text: 'Если вы едете на машине из центра:' },
				{ list: [
					'Двигайтесь по Старой Басманной улице',
					'Через 100 метров после Елоховской площади поверните налево на Нижнюю Красносельскую улицу',
					'Через 500 метров поверните налево на Ольховскую улицу',
					'Через 150 метров справа вы увидите Институт Пластической Хирургии и Косметологии',
				] },
				{ text: 'Для удобства гостей предусмотрена отдельная парковка по две стороны от входа с въездом под шлагбаум. Для того, чтобы попасть на парковку необходимо подъехать к шлагбауму с левой или с правой стороны здания. При наличии свободных мест охрана вас запустит.' },
			],
		},
	]

section.route
	.container.route__container
		a.route__map(href=routeMapHref target="_blank" rel="noopener" aria-label="Открыть схему проезда в Яндекс Картах")
			picture.route__picture
				source(media="(min-width: 768px)" srcset=`${baseDir}images/content/contacts/map.webp 1x, ${baseDir}images/content/contacts/map@2x.webp 2x` width="1321" height="638")
				img.route__image(src=`${baseDir}images/content/contacts/map-mobile.webp` srcset=`${baseDir}images/content/contacts/map-mobile@2x.webp 2x` width="359" height="173" alt="Схема проезда к клинике от метро Чистые пруды и Тургеневская" loading="lazy" decoding="async")
		.route__columns
			each column in routeColumns
				.route__column
					h2.route__title= column.title
					.route__body
						each part in column.parts
							if part.list
								ul.route__list
									each item in part.list
										li.route__item!= nbsp(item)
							else
								p.route__text!= nbsp(part.text)
