//- Компоненты UI-кита. Данные передаются объектом — так видно, что подставит WordPress

//- @demo +switcher({ name: 'notify', checked: true, label: 'Уведомления' })
mixin switcher(data)
	label.switcher&attributes(attributes)
		input.switcher__input(type="checkbox" name=data.name checked=data.checked aria-label=data.label)
		span.switcher__track

//- @demo +radio({ name: 'type', value: '1', label: 'Вариант', checked: true })
mixin radio(data)
	label.radio&attributes(attributes)
		input.radio__input(type="radio" name=data.name value=data.value checked=data.checked)
		span.radio__box
		if data.label
			span.radio__text= data.label

//- @demo +checkbox({ name: 'agree', label: 'Согласен', checked: true })
mixin checkbox(data)
	label.checkbox.checkbox--plain&attributes(attributes)
		input.checkbox__input(type="checkbox" name=data.name value=data.value || '1' checked=data.checked)
		span.checkbox__box
		if data.label
			span.checkbox__text= data.label

//- Select: поле-кнопка, под ним выпадающий список. Выбранное поле бирюзовое, с крестиком очистки.
//- multiple — несколько значений с чекбоксами, в поле «Выбрано N»; иначе одно значение (radio без чекбоксов), в поле его название.
//- options — строки или { title, value, checked }; value — выбранное по умолчанию (для одиночного)
//- @demo +select({ name: 'doctor', label: 'Выберите врача', options: ['Сергеев И.В.', 'Труфанов Д.И.'] })
//- @demo +select({ name: 'tags[]', label: 'Выберите тему', multiple: true, options: [{ title: 'Грудь', checked: true }, 'Лицо'] })
mixin select(data)
	-
		const selectOptions = data.options.map((option) => {
			const item = typeof option === 'object' ? option : { title: option }
			return Object.assign({}, item, { value: item.value || item.title, checked: item.checked || item.title === data.value })
		})
		const checkedOptions = selectOptions.filter((option) => option.checked)
		const selectText = !checkedOptions.length ? data.label : data.multiple ? `Выбрано ${checkedOptions.length}` : checkedOptions[0].title
	.select(class=checkedOptions.length ? 'is-active' : null data-select=data.multiple ? 'multiple' : 'single' data-placeholder=data.label)&attributes(attributes)
		button.select__control(type="button" aria-expanded="false" aria-label=data.label data-select-toggle)
			span.select__text(data-select-text)= selectText
		button.select__clear(type="button" aria-label="Очистить" data-select-clear)
			+svg('close').select__clear-icon
		+svg('dropdown').select__icon
		.drop-list.select__drop
			ul.drop-list__list
				each option in selectOptions
					li
						if data.multiple
							label.checkbox.checkbox--plain
								input.checkbox__input(type="checkbox" name=data.name value=option.value checked=option.checked data-select-input)
								span.checkbox__box
								span.drop-list__label= option.title
						else
							label.select__option
								input.select__input(type="radio" name=data.name value=option.value checked=option.checked data-select-input)
								span.drop-list__label.select__option-text= option.title

//- @demo +fileField({ name: 'photo', label: 'Прикрепить фото' })
mixin fileField(data)
	label.file-field&attributes(attributes)
		input.file-field__input(type="file" name=data.name accept=data.accept || 'image/*' multiple)
		+svg('file').file-field__icon
		span.file-field__text(data-file-label)= data.label

//- @demo +dropList({ name: 'services[]', items: ['Увеличение груди'] })
mixin dropList(data)
	.drop-list&attributes(attributes)
		ul.drop-list__list
			each item in data.items
				li.drop-list__item
					label.checkbox.checkbox--plain
						input.checkbox__input(type="checkbox" name=data.name value=item)
						span.checkbox__box
						span.drop-list__label= item

//- Список вопросов (аккордеон). items = [{ question, answer, open }], id — префикс id ответов (уникален на странице)
//- @demo +faqList([{ question: 'Вопрос?', answer: 'Ответ', open: true }], 'faq-demo')
mixin faqList(items, id)
	ul.faq__list(data-faq)&attributes(attributes)
		each item, index in items
			li.faq__item(class=item.open ? 'is-open' : null data-faq-item)
				button.faq__question(type="button" aria-expanded=item.open ? 'true' : 'false' aria-controls=`${id}-${index}` data-faq-toggle)
					img.faq__logo(src=`${baseDir}images/icons/logo-sign.svg` width="32" height="32" alt="")
					span.faq__question-text= item.question
					+svg('chevron-down').faq__arrow
				.faq__answer(id=`${id}-${index}` aria-hidden=item.open ? 'false' : 'true')
					.faq__answer-inner
						p.faq__answer-text= item.answer

//- Кнопка раскрытия collapse. sub — подкатегория: мельче, со стрелкой-шевроном вместо круглой кнопки
mixin collapseHead(data)
	button.collapse__head(type="button" aria-expanded=data.open ? 'true' : 'false' data-collapse-toggle)
		span.collapse__title= data.title
		if data.sub
			+svg('chevron-down').collapse__chevron
		else
			span.btn-round.btn-round--down.collapse__btn(class=data.open ? 'is-open' : null)
				+svg('arrow-right').btn-round__icon

//- { title, open, sub, heading } — heading: тег заголовка вокруг кнопки ('h2', 'h3')
//- @demo +collapse({ title: 'Гинекология', open: false }) Контент
mixin collapse(data)
	.collapse(class=[data.sub ? 'collapse--sub' : null, data.open ? 'is-open' : null] data-collapse)&attributes(attributes)
		if data.heading
			#{data.heading}.collapse__heading
				+collapseHead(data)
		else
			+collapseHead(data)
		.collapse__body(aria-hidden=data.open ? 'false' : 'true')
			.collapse__inner
				.collapse__content
					block

//- Строка прайса: { name, price, oldPrice, note }
mixin priceLine(item)
	li.price-line(class=item.note ? 'price-line--include' : null)&attributes(attributes)
		if item.note
			.price-line__info
				p.price-line__name= item.name
				p.price-line__note= item.note
		else
			p.price-line__name= item.name
		p.price-line__value
			if item.oldPrice
				s.price-line__old= item.oldPrice
			span.price-line__price= item.price

//- @demo +serviceRow({ title: 'Увеличение груди', href: '#' })
mixin serviceRow(data)
	a.service-row(href=data.href)&attributes(attributes)
		span.service-row__title= data.title
		span.btn-round.btn-round--link.service-row__btn
			+svg('arrow-right').btn-round__icon
		if data.preview
			span.service-row__preview(aria-hidden="true")
				+picture(data.preview, '', 361, 481).service-row__preview-image
				img.service-row__mark.service-row__mark--first(src=`${baseDir}images/content/ui/service-mark-1.png` width="56" height="30" alt="")
				img.service-row__mark.service-row__mark--second(src=`${baseDir}images/content/ui/service-mark-2.png` width="60" height="30" alt="")

//- @demo +categoryTab({ title: 'Грудь', image: 'ui/tab-breast', active: true })
mixin categoryTab(data)
	button.category-tab(class=data.active ? 'is-active' : null type="button" aria-pressed=data.active ? 'true' : 'false')&attributes(attributes)
		+picture(data.image, '', 135, 96).category-tab__image
		span.category-tab__title= data.title

//- @demo +breadcrumbs([{ title: 'Главная', href: '/' }, { title: 'Текущая' }])
mixin breadcrumbs(items)
	nav.breadcrumbs(aria-label="Хлебные крошки")&attributes(attributes)
		ol.breadcrumbs__list(itemscope itemtype="https://schema.org/BreadcrumbList")
			each item, index in items
				li.breadcrumbs__item(itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem")
					if item.href
						a.breadcrumbs__link(href=item.href itemprop="item")
							span(itemprop="name")= item.title
					else
						span.breadcrumbs__current(aria-current="page" itemprop="name")= item.title
					meta(itemprop="position" content=index + 1)
					if index < items.length - 1
						+svg('chevron-down').breadcrumbs__separator

//- Пагинация. Страницы с desktop: true скрыты на мобильных
//- @demo +pagination({ current: 1, pages: ['1', '2', { page: '3', desktop: true }, '...', '40'] })
mixin pagination(data)
	nav.pagination(aria-label="Пагинация")&attributes(attributes)
		+btnRound('prev', 'Предыдущая страница').pagination__btn
		ul.pagination__list
			each entry in data.pages
				- const page = typeof entry === 'object' ? entry.page : entry
				li.pagination__item(class=entry.desktop ? 'pagination__item--desktop' : null)
					if page === '...'
						span.pagination__link ...
					else
						a.pagination__link(class=page === String(data.current) ? 'is-active' : null href="#" aria-current=page === String(data.current) ? 'page' : null)= page
		+btnRound('next', 'Следующая страница').pagination__btn

//- Карточка статьи: { title, text, date, image, href }
mixin articleCard(data)
	article.article-card&attributes(attributes)
		a.article-card__photo(href=data.href)
			+picture(data.image, data.title, 423, 280).article-card__image
		.article-card__body
			h3.article-card__title
				a(href=data.href)= data.title
			p.article-card__text= data.text
			time.article-card__date(datetime=data.datetime)= data.date

//- Карточка новости: { title, text, date, image, href }
mixin newsCard(data)
	article.news-card&attributes(attributes)
		.news-card__photo
			+picture(data.image, data.title, 512, 340).news-card__image
		.news-card__body
			.news-card__head
				h3.news-card__title= data.title
				time.news-card__date(datetime=data.datetime)= data.date
			p.news-card__text= data.text
			a.btn-play.news-card__more(href=data.href aria-label="Читать новость")
				+svg('arrow-right').btn-play__icon.btn-play__icon--stroke

//- Карточка врача с кнопкой «Оставить отзыв»: { lastName, name, position, image, imageWidth, imageHeight, href, btnAttrs }
//- Без href кнопка — <button>; btnAttrs — атрибуты кнопки (JS-хуки)
mixin doctorTeaser(data)
	article.doctor-teaser&attributes(attributes)
		.doctor-teaser__main
			.doctor-teaser__photo
				+picture(data.image, `${data.lastName} ${data.name}`, data.imageWidth || 130, data.imageHeight || 87).doctor-teaser__image
			.doctor-teaser__info
				h3.doctor-teaser__name
					span.doctor-teaser__last-name= data.lastName
					span.doctor-teaser__first-name= data.name
				p.doctor-teaser__position= data.position
		+btn('Оставить отзыв', { href: data.href }).doctor-teaser__btn&attributes(data.btnAttrs || {})

//- Карточка услуги с фото: { title, image, href }
mixin serviceCard(item)
	a.service-card(href=item.href)&attributes(attributes)
		.service-card__visual
			span.service-card__circle
			.service-card__image-wrap
				+picture(item.image, item.title, 290, 193).service-card__image
		span.service-card__title= item.title

//- Карточка «до/после»: { title, before, after, counter }
mixin resultCard(work)
	.result-card(data-compare)&attributes(attributes)
		.result-card__media
			.result-card__side.result-card__side--before
				+picture(work.before, `${work.title} — до`, 798, 455).result-card__image
				span.result-card__mark.result-card__mark--desktop.result-card__mark--before
				span.result-card__mark.result-card__mark--mobile.result-card__mark--left
				span.result-card__mark.result-card__mark--mobile.result-card__mark--right
			.result-card__side.result-card__side--after
				+picture(work.after, `${work.title} — после`, 798, 455).result-card__image
				span.result-card__mark.result-card__mark--desktop.result-card__mark--after
				span.result-card__mark.result-card__mark--mobile.result-card__mark--left
				span.result-card__mark.result-card__mark--mobile.result-card__mark--right
			.result-card__handle(data-compare-handle)
				img.result-card__handle-icon(src=`${baseDir}images/icons/compare-handle.svg` width="72" height="72" alt="")
		.result-card__caption
			span.result-card__name= work.title
			span.result-card__counter= work.counter

//- Карточка врача: { lastName, name, photo, operations, text }
mixin doctorCard(doctor)
	article.doctor-card&attributes(attributes)
		.doctor-card__photo
			if doctor.operations
				p.doctor-card__operations= doctor.operations
			+picture(doctor.photo, `${doctor.lastName} ${doctor.name}`, 365, 463).doctor-card__image
		.doctor-card__body
			h3.doctor-card__name
				span.doctor-card__last-name
					= doctor.lastName
					+verified
				span.doctor-card__first-name= doctor.name
		//- Подробности: на мобильных под именем, с 1024 — блок, который по hover поднимается снизу карточки (имя в нём повторяется)
		if doctor.text
			.doctor-card__details
				p.doctor-card__name.doctor-card__details-name(aria-hidden="true")
					span.doctor-card__last-name
						= doctor.lastName
						+verified
					span.doctor-card__first-name= doctor.name
				p.doctor-card__text= doctor.text
				+btn('Записаться на консультацию', { href: '#signup-popup' }).btn--full.doctor-card__btn(data-signup-open)

//- Карточка отзыва: { lastName, name, photo, text, video }
mixin reviewCard(review)
	article.review-card&attributes(attributes)
		.review-card__photo
			+picture(review.photo, `${review.lastName} ${review.name}`, 425, 490).review-card__image
		.review-card__body
			h3.review-card__name
				span.review-card__last-name
					= review.lastName
					+verified
				span.review-card__first-name= review.name
			p.review-card__text= review.text
		.review-card__actions
			a.btn-play.review-card__play(href=review.video aria-label="Смотреть видеоотзыв" data-fancybox)
				+svg('play').btn-play__icon
			+btn('Видеоотзыв', { href: review.video }).review-card__btn(data-fancybox)

//- Кейс «до/после» с ракурсами (вкладки «Спереди» / «Сбоку»): { number, operation, doctor, views: [{ title, icon, before, after }] }
mixin photoCase(data)
	article.photo-case(data-photo-case)&attributes(attributes)
		.photo-case__head
			h3.visually-hidden= `${data.operation}, ${data.doctor} — до и после`
			dl.photo-case__meta
				.photo-case__row
					dt.photo-case__label Операция:
					dd.photo-case__value= data.operation
				.photo-case__row
					dt.photo-case__label Доктор:
					dd.photo-case__value= data.doctor
			span.photo-case__number= data.number
		each view, index in data.views
			.photo-case__photos(data-photo-case-panel=index hidden=index > 0)
				each side in ['before', 'after']
					figure.photo-case__photo
						.photo-case__frame
							+picture(view[side], `${data.operation}, ${view.title.toLowerCase()} — ${side === 'before' ? 'до' : 'после'} операции`, 456, 370).photo-case__image(class=`photo-case__image--${side}`)
							span.photo-case__mark(class=`photo-case__mark--${side}-left` aria-hidden="true")
							span.photo-case__mark(class=`photo-case__mark--${side}-right` aria-hidden="true")
						figcaption.photo-case__caption(class=`photo-case__caption--${side}`)= side === 'before' ? 'До операции' : 'После операции'
		.photo-case__views
			each view, index in data.views
				button.photo-case__tab(type="button" class=index === 0 ? 'is-active' : null aria-pressed=String(index === 0) data-photo-case-tab=index)
					+svg(view.icon).photo-case__tab-icon
					span= view.title

//- Форма записи с фото: секция «Записаться» на страницах и попап. titleId — id заголовка для aria-labelledby попапа
mixin signupForm(data)
	- const opts = data || {}
	form.signup__form(action="#" method="post" data-signup-form)
		if opts.titleId
			p.title.signup__title(id=opts.titleId) Записаться
		else
			h2.title.signup__title Записаться
		.signup__fields
			input.field.signup__field(type="text" name="your-name" placeholder="Имя" autocomplete="name" required)
			input.field.signup__field(type="tel" name="your-phone" placeholder="Телефон" autocomplete="tel" required)
			label.checkbox.signup__checkbox
				input.checkbox__input(type="checkbox" name="marketing" value="1" checked)
				span.checkbox__box
				span.checkbox__text Получать маркетинговые предложения и рекламу
			p.signup__policy
				| Нажимая на кнопку, вы даете согласие на обработку данных
				br.signup__break
				|  и соглашаетесь с
				= ' '
				a.signup__policy-link(href="#") Политикой конфиденциальности
				| .
		button.btn.btn--full.signup__submit(type="submit")
			span Записаться на консультацию
	.signup__visual
		+picture('form/woman', 'Записаться на консультацию', 770, 513).signup__image
