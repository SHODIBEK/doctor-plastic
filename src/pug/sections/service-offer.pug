-
	const priceOffer = {
		price: '279 900 ₽',
		oldPrice: '468 000 ₽',
		note: 'Всё включено: операция, имплантаты, палата, наркоз',
		gifts: [
			{ title: 'Консультация хирурга', oldPrice: '3 000 ₽' },
			{ title: '3D-моделирование', oldPrice: '23 000 ₽' },
		],
		text: ['Одним из направлений эстетической хирургии, на котором специализируются врачи клиники «ДОКТОРПЛАСТИК», является увеличение груди.', 'Пластические хирурги клиники имеют большой практический опыт и авторские методики работы, которые гарантируют пациентам именно тот результат, который они ожидают увидеть.'],
		avatars: ['works/avatar-1', 'works/avatar-2', 'works/avatar-3', 'works/avatar-4', 'works/avatar-5'],
	}

section.service-offer#service-offer
	.container.container--narrow.service-offer__container
		.service-offer__card
			p.service-offer__prices
				span.service-offer__price= priceOffer.price
				= ' '
				s.service-offer__old-price= priceOffer.oldPrice
			p.service-offer__note= priceOffer.note
			ul.service-offer__gifts
				each offerGift in priceOffer.gifts
					li.service-offer__gift
						span.service-offer__gift-icon
							img.service-offer__gift-image(src=`${baseDir}images/icons/gift.svg` width="40" height="40" alt="")
						span.service-offer__gift-text
							span.service-offer__gift-title= offerGift.title
							span.service-offer__gift-price
								s= offerGift.oldPrice
								|  Бесплатно!
		.service-offer__body
			.service-offer__about
				.service-offer__text
					each text in priceOffer.text
						p.service-offer__paragraph= text
				.service-offer__patients
					p.service-offer__patients-count +10 000 довольных пациенток
					.service-offer__avatars
						each avatar in priceOffer.avatars
							+picture(avatar, '', 80, 80).service-offer__avatar
			form.service-offer__form(action="#" method="post" data-signup-form)
				.service-offer__fields
					input.field(type="text" name="your-name" placeholder="Имя" autocomplete="name" aria-label="Имя" required)
					input.field(type="tel" name="your-phone" placeholder="Телефон" autocomplete="tel" aria-label="Телефон" required)
					p.service-offer__policy
						| Нажимая на кнопку, вы даете согласие на обработку данных и соглашаетесь с#{' '}
						a.service-offer__policy-link(href="#") Политикой конфиденциальности
						| .
				button.btn.btn--full.service-offer__submit(type="submit")
					span Записаться на консультацию
