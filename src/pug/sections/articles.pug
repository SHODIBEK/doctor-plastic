-
	const articleSections = ['Новости клиники', 'Пластика груди', 'Пластика лица', 'Пластика тела']
	const articleTags = [
		{ title: 'Награды', checked: true },
		{ title: 'Мероприятия', checked: true },
		{ title: 'Врачи клиники', checked: true },
		{ title: 'Обучение' },
		{ title: 'Оплата' },
	]
	const articles = [
		{ title: 'Новость этой весны: у клиники «ДокторПластик» две награды!', text: 'Состоялась IX церемония награждения лауреатов всемирно известной премии «Хрустальный Лотос». У нас две замечательные новости: пластические хирурги нашей клиники в очередной раз признаны одними из лучших.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/crystal-awards', href: '#' },
		{ title: 'Доктор Труфанов – лауреат одной из самых престижных премий «Хрустальный Лотос»', text: '29 Ноября 2021 года Труфанов Дмитрий Игоревич стал лауреатом одной из самых престижных премий в мире современной пластической хирургии «Хрустальный Лотос».', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/trufanov-lotus', href: '#' },
		{ title: 'Доктор Сергеев выступил в качестве эксперта жюри', text: 'Церемония вручения премии «Хрустальный Лотос» – всегда грандиозное событие для пластических хирургов, косметологов, стоматологов и специалистов других направлений.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/sergeev-jury', href: '#' },
		{ title: '«ДокторПластик» объявлена лучшей клиникой пластической хирургии и косметологии', text: 'Информационный портал MEDAFARM.RU ежегодно проводит свой знаменитый Рейтинг лучших пластических хирургов и клиник года. В 2019 плодотворная работа специалистов DoctorPlastic была удостоена высших оценок.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/medafarm-rating', href: '#' },
		{ title: 'Услуги «ДокторПластик» в кредит: новые возможности!', text: 'Крупнейшая клиника пластической хирургии и косметологии «ДокторПластик» теперь предлагает своим клиентам возможность оплаты услуг в кредит.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/credit', href: '#' },
		{ title: 'Открытие школы пластической хирургии груди профессора Сергеева', text: '30 ноября состоялось долгожданное открытие школы пластической хирургии груди профессора Сергеева и старт первого учебного блока, темой которого было простое увеличение груди.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/breast-school', href: '#' },
		{ title: 'В Москве прошел однодневный курс Доктора Сергеева и Джино Риготти', text: '3 ноября 2019 года Сергеев Илья Вячеславович вместе с Джино Риготти (Gino Rigotti) провели лекции и мастер-классы. Лучшие специалисты поделились опытом и рассказали об особенностях применения технологий липофилинга.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/rigotti-course', href: '#' },
		{ title: 'Пользователи Plasticbreast назвали Илью Сергеева лучшим хирургом по пластике груди', text: 'Известный портал Plasticbreast.ru проводит голосования за лучших специалистов в сфере эстетической и реконструктивной хирургии. Это позволяет пациентам определить лидеров данной области и найти для своей операции хирурга.', date: '04.05.2023', datetime: '2023-05-04', image: 'articles/plasticbreast', href: '#' },
	]

section.articles
	.container
		h2.visually-hidden Статьи и новости клиники
		form.articles__filters(action="#")
			+select({ name: 'section', label: 'Выберите раздел блога', options: articleSections }).articles__select
			+select({ name: 'tags[]', label: 'Выберите тему', multiple: true, options: articleTags }).articles__select
			button.btn.articles__reset(type="reset")
				span Очистить
		ul.articles__list
			each article in articles
				li
					+newsCard(article)
		+pagination({ current: 1, pages: ['1', '2', { page: '3', desktop: true }, { page: '4', desktop: true }, { page: '5', desktop: true }, '...', '40'] }).articles__pagination
