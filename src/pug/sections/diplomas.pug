-
	const diplomas = [
		{ image: 'diplomas/diploma-1', size: 'wide', width: 289, height: 200 },
		{ image: 'diplomas/diploma-2', size: 'narrow', width: 136, height: 200 },
		{ image: 'diplomas/diploma-3', size: 'narrow', width: 136, height: 200 },
		{ image: 'diplomas/diploma-4', size: 'large', width: 283, height: 200 },
		{ image: 'diplomas/diploma-5', size: 'narrow', width: 136, height: 200 },
		{ image: 'diplomas/diploma-6', size: 'wide', width: 289, height: 200 },
		{ image: 'diplomas/diploma-5', size: 'narrow', width: 136, height: 200 },
		{ image: 'diplomas/diploma-1', size: 'wide', width: 289, height: 200 },
	]

section.diplomas#diplomas
	.container.diplomas__container
		h2.title.diplomas__title!= typeof diplomasTitle !== 'undefined' ? diplomasTitle : 'Дипломы и сертификаты'
		.diplomas__slider
			.diplomas__viewport.swiper(data-diplomas-swiper)
				.diplomas__track.swiper-wrapper
					each item in diplomas
						a.diplomas__item.swiper-slide(class=`diplomas__item--${item.size}` href=`${baseDir}images/content/${item.image}@2x.webp` data-fancybox="diplomas" data-diplomas-slide)
							//- С 1024 центральный слайд увеличивается в 1.4 раза — sizes подсказывает браузеру взять @2x
							+lazyImage({
								src: `${baseDir}images/content/${item.image}.webp`,
								srcset: `${baseDir}images/content/${item.image}.webp ${item.width}w, ${baseDir}images/content/${item.image}@2x.webp ${item.width * 2}w`,
								alt: 'Диплом',
							}).diplomas__image(width=item.width height=item.height sizes=`(min-width: 1024px) ${Math.round(item.width * 1.4)}px, ${item.width}px`)
			.diplomas__nav
				+btnRound('prev').diplomas__nav-btn(data-diplomas-prev)
				+btnRound('next').diplomas__nav-btn(data-diplomas-next)
