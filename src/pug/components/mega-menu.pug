mixin megaText(text)
	each line, i in text.split('\n')
		if i
			br
		| #{line}

.mega-menu#mega-menu(data-mega-menu)
	.mega-menu__wrap
		.container.mega-menu__container
			.mega-menu__aside
				.mega-menu__tabs(role="tablist" aria-label="Направления")
					each category, i in megaMenu
						button.mega-menu__tab(
							class=i === 0 ? 'is-active' : null
							type="button"
							role="tab"
							id=`mega-tab-${i}`
							aria-selected=i === 0 ? 'true' : 'false'
							aria-controls=`mega-panel-${i}`
							tabindex=i === 0 ? null : '-1'
							data-mega-tab
						)
							span.mega-menu__tab-text= category.title
							span.mega-menu__tab-icon
								+svg('arrow-right').mega-menu__tab-arrow
				+picture('mega-menu/aside', '', 270, 350).mega-menu__aside-image

			each category, i in megaMenu
				.mega-menu__panel(
					class=i === 0 ? 'is-active' : null
					role="tabpanel"
					id=`mega-panel-${i}`
					aria-labelledby=`mega-tab-${i}`
					hidden=i !== 0
					data-mega-panel
				)
					each group, j in category.groups
						.mega-menu__group(data-mega-group)
							//- Десктоп: карточка с фото и заголовок-ссылка
							a.mega-menu__card(href=group.href)
								if group.image
									+picture(group.image, group.title, 241, 120).mega-menu__image
								span.mega-menu__title= group.title
							//- Мобильный: заголовок раскрывает список
							button.mega-menu__toggle(type="button" aria-expanded="false" aria-controls=`mega-list-${i}-${j}` data-mega-group-toggle)
								span.mega-menu__toggle-text= group.title
								span.mega-menu__toggle-icon
									+svg('arrow-right').mega-menu__toggle-arrow
							.mega-menu__body(id=`mega-list-${i}-${j}`)
								ul.mega-menu__list
									each link in group.links
										li.mega-menu__item
											a.mega-menu__link(href=link.href)
												+megaText(link.title)
									li.mega-menu__item.mega-menu__item--all
										a.mega-menu__all(href=group.href) Все услуги раздела
