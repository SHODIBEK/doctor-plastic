extends pug/layout

append vars
	- title = 'Услуги клиники пластической хирургии — Доктор Пластик'
	- meta.description = meta.ogDescription = meta.twitterDescription = 'Услуги клиники «Доктор Пластик»: увеличение и подтяжка груди, абдоминопластика. Ведущие хирурги, отзывы пациентов, ответы на вопросы, запись на консультацию.'
	- meta.ogTitle = meta.twitterTitle = title
	-
		const pageHead = {
			crumbs: [{ title: 'Главная', href: './home.html' }, { title: 'Услуги нашей клиники' }],
			accent: 'Услуги',
			title: 'нашей клиники',
		}
		const articleContent = {
			title: 'Увеличение груди',
			intro: ['Эндопротезирование проводится по инициативе пациентки, медицинских показаний к данной операции не существует. Желание увеличить грудь может возникнуть по разным причинам: кто-то не доволен своим размером, кто-то стесняется видимой асимметрии, для кого-то важно восстановить форму и привлекательность после окончания грудного вскармливания. Стоит отметить, что в случае асимметрии хирург подбирает имплантаты разных размеров, чтобы обе груди в итоге выглядели одинаково. В случае восстановления объема и формы груди после кормления ребенка наши специалисты рекомендуют проходить увеличение без подтяжки. В центре «Бюстклиника» мы используем имплантаты Sebbin с когезивным гелем, который обладает эффектом памяти формы и не вытекает в случае механического повреждения оболочки.'],
			blocks: [
				{ title: 'У нас выгодно', text: ['Для всех, без исключения, специалистов «Бюстклиники» маммопластика — это не только профессия, но и искусство.', 'Работу наших специалистов отличает высочайший профессионализм и безукоризненное качество. При этом, мы предлагаем на такую операцию, как пластика груди, цены, доступные практически каждой женщине. Возникает закономерный вопрос: почему цены на маммопластику в «Бюстклиника» почти в два раза ниже, чем у конкурентов? Ведь маммопластика в Москве часто оказывается удовольствием не из дешёвых.'] },
				{ title: 'Почему нам доверяют', text: ['Существует два фактора, которые позволяют нам предлагать разумные цены на маммопластику, не жертвуя высочайшим качеством. Первый фактор — наша популярность. Большой поток клиентов, привлечённых хорошей репутацией «Бюстклиники», позволяет нам держать высокую планку, не завышая цену, чтобы остаться на плаву.', 'Второй фактор — отличные отношения с крупнейшими мировыми производителями высококачественных имплантов Sebbin. Наш партнёр идёт навстречу нам в поисках взаимовыгодных антикризисных решений, а мы идём навстречу нашим клиентам, предлагая высокое качество по разумной цене.'] },
				{ title: 'Как сделать первый шаг?', text: ['Итак, вы решились на пластику грудей в Москве? Наши профессионалы обследуют вас и помогут принять верное решение. «Бюстклиника» — именно то место, где вы станете обладательницей идеальной груди за адекватные деньги. Мы делаем красоту доступной!'] },
			],
		}

block main
	include pug/sections/page-head
	.panel
		include pug/sections/services
		include pug/sections/doctors
		include pug/sections/article
		include pug/sections/reviews
		include pug/sections/faq
		include pug/sections/advantages
		include pug/sections/diplomas
		include pug/sections/signup
		include pug/sections/related
