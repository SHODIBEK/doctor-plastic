extends pug/layout

append vars
	- title = 'Видео-отзывы пациентов клиники «Доктор Пластик»'
	- meta.description = meta.ogDescription = meta.twitterDescription = 'Видео-отзывы пациентов клиники пластической хирургии «Доктор Пластик»: истории операций у доктора Сергеева и доктора Труфанова. Оставьте свой отзыв о враче.'
	- meta.ogTitle = meta.twitterTitle = title
	-
		const pageHead = {
			modifier: 'reviews',
			crumbs: [{ title: 'Главная', href: './home.html' }, { title: 'Отзывы', href: './reviews.html' }, { title: 'Видео-отзывы' }],
			accent: 'Видео-отзывы',
			circle: 'reviews-head/circle',
			woman: { desktop: 'reviews-head/woman', desktopWidth: 1011, desktopHeight: 1064, retina: true, mobile: 'reviews-head/woman-mobile', mobileWidth: 247, mobileHeight: 307 },
		}

block main
	include pug/sections/page-head
	.panel.panel--reviews
		include pug/sections/video-reviews
		include pug/sections/review-form
