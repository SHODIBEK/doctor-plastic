-
	const faqAnswer = 'Методики, применяемые в нашей клинике, сводят такой риск к минимуму. Молочная железа во время коррекции либо не повреждается, либо ее повреждения незначительны. Так что сама операция на грудное вскармливание большого влияния не оказывает.'
	const faq = [
		{ question: 'Можно ли сохранить способность к грудному вскармливанию после увеличения груди?', answer: faqAnswer, open: true },
		{ question: 'Какие анализы сдают перед операцией по увеличению груди?', answer: faqAnswer },
		{ question: 'Остаются ли шрамы после увеличения груди?', answer: faqAnswer },
		{ question: 'Какой период реабилитации после проведенной операции по увеличению груди?', answer: faqAnswer },
	]

section.faq#faq
	.container.faq__container
		h2.title.faq__title Вопрос-ответ
		+faqList(faq, 'faq-answer')
		+btn('Задать свой вопрос', { href: '#signup' }).faq__btn
