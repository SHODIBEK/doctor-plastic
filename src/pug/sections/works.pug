-
	const worksFilters = [
		{ name: 'type', label: 'Выберите вид пластики', value: 'Пластика тела', options: ['Пластика тела', 'Пластика груди', 'Пластика лица'] },
		{ name: 'body', label: 'Выберите телосложение', options: ['Худощавое', 'Среднее', 'Плотное'] },
		{ name: 'surgeon', label: 'Все хирурги', options: ['Сергеев И. В.', 'Труфанов Д. И.'] },
	]
	const works = [
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
		{ title: 'Увеличение груди', before: 'works/before', after: 'works/after' },
	]
	const worksAvatars = ['works/avatar-1', 'works/avatar-2', 'works/avatar-3', 'works/avatar-4', 'works/avatar-5']

section.works#works
	.container
		h2.title.works__title= typeof worksTitle !== 'undefined' ? worksTitle : 'Наши работы'
		form.works__filters(action="#")
			each filter in worksFilters
				+select(filter).works__select
			button.btn.btn--gray.works__reset(type="reset")
				span Очистить
				+svg('close').btn__icon
	.works__slider.swiper(data-works-slider)
		.works__track.swiper-wrapper
			each work, index in works
				.works__slide.swiper-slide
					+resultCard(Object.assign({ counter: `${String(index + 1).padStart(2, '0')}/16` }, work))
	.container.works__footer(class=typeof worksMore !== 'undefined' && !worksMore ? 'works__footer--nav' : null)
		.works__nav
			+btnRound('prev').works__prev(data-works-prev)
			+btnRound('next').works__next(data-works-next)
		//- worksMore = false — без «Смотреть все работы» и аватаров (страница врача)
		if typeof worksMore === 'undefined' || worksMore
			.works__bottom
				+btn('Смотреть все работы', { href: '#' }).works__all
				.works__more
					.works__avatars
						each avatar in worksAvatars
							+picture(avatar, '', 80, 80).works__avatar
					p.works__count +500 до/после
