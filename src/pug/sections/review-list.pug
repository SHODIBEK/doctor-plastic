section.review-list
	.container
		h2.visually-hidden Отзывы
		.review-list__items
			each review in reviewList
				article.review-item
					.review-item__photo
						- const photoSrc = `${baseDir}images/content/${review.photo}`
						img.review-item__image(src=`${photoSrc}.webp` srcset=`${photoSrc}.webp 512w, ${photoSrc}@2x.webp 1024w` sizes="(min-width: 1024px) min(512px, 36vw), calc(100vw - 30px)" width="512" height="512" alt=`${review.name} — фото пациентки` loading="lazy" decoding="async")
					.review-item__body
						.review-item__main
							.review-item__head
								h3.review-item__name
									= review.name
									+verified
								p.review-item__role= review.role
							dl.review-item__meta
								dt.review-item__label Операция:
								dd.review-item__value= review.operation
								dt.review-item__label Доктор:
								dd.review-item__value= review.doctor
								dt.review-item__label Instagram:
								dd.review-item__value
									a.review-item__link(href=`https://instagram.com/${review.instagram}` target="_blank" rel="noopener nofollow")= `@${review.instagram}`
							p.review-item__text= review.text
						if review.video
							a.review-item__video(href=review.video data-fancybox)
								span.btn-play.review-item__play
									+svg('play').btn-play__icon
								span.btn.review-item__btn
									span Видеоотзыв
		+pagination({ current: 1, pages: ['1', '2', { page: '3', desktop: true }, { page: '4', desktop: true }, { page: '5', desktop: true }, '...', '40'] }).review-list__pagination
