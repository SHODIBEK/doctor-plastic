//- Список услуг. Страница может задать servicesList = { items, modifier, visible, mobileVisible, more }:
//- карточки после visible (на мобильном — после mobileVisible) скрыты до нажатия «Развернуть»
-
	const servicesData = typeof servicesList !== 'undefined' ? servicesList : {
		items: [
			{ title: 'Увеличение груди', image: 'services/service-1', href: './service.html' },
			{ title: 'Подтяжка груди', image: 'services/service-2', href: '#' },
			{ title: 'Абдоминопластика', image: 'services/service-3', href: '#' },
		],
	}
	const servicesHidden = (index) => {
		if (servicesData.visible && index >= servicesData.visible) {
			return 'services__item--hidden'
		}

		return servicesData.mobileVisible && index >= servicesData.mobileVisible ? 'services__item--mobile-hidden' : null
	}

section.services#services(class=servicesData.modifier ? `services--${servicesData.modifier}` : null data-expand)
	.container.services__container
		if servicesData.title
			h2.title.services__title= servicesData.title
		ul.services__list
			each item, index in servicesData.items
				li.services__item(class=servicesHidden(index))
					+serviceCard(item)(class=servicesData.modifier === 'catalog' ? 'service-card--compact' : null)
		if servicesData.more
			+btn(servicesData.more).services__more(data-expand-toggle)
